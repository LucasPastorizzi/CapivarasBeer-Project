# Banco de dados. Em desenvolvimento usamos SQLite (arquivo local).
# Em produção, troque para a connection string do PostgreSQL:
# DATABASE_URL="postgresql://usuario:senha@host:5432/capivaras"
DATABASE_URL="file:./prisma/dev.db"

# Chave que assina o cookie de sessão. Gere a sua com: openssl rand -base64 32
# Sem ela a aplicação não autentica ninguém.
SESSION_SECRET="troque-esta-chave-em-producao"

# Só defina se o login ficar em vaivém com a tela de entrada.
# O cookie de sessão só é aceito pelo navegador em HTTPS quando marcado como
# "secure". A aplicação descobre o protocolo sozinha pelo cabeçalho
# x-forwarded-proto; se a sua hospedagem não repassa esse cabeçalho, force:
#   COOKIE_SECURE="false"  -> deploy em HTTP puro
#   COOKIE_SECURE="true"   -> deploy em HTTPS atrás de proxy silencioso
# COOKIE_SECURE=

# ── Assistente de IA ─────────────────────────────────────────────────────────
# Sem nenhuma chave, a aba Assistente avisa o que falta e o resto do sistema
# funciona normalmente.
#
# Qual serviço responde. Se não definir, vale a chave que estiver preenchida.
# Valores aceitos: openai | claude
ASSISTENTE_IA="openai"

# OpenAI — chave em https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Opcional. O catálogo da OpenAI muda e cada conta libera modelos diferentes;
# se o padrão não estiver disponível, o erro na tela lista o que fazer.
OPENAI_MODEL="gpt-4o"

# Claude — chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"
