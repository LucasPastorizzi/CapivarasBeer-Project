// Schema do sistema de gestão do Capivaras Beer.
//
// Convenções adotadas:
// - Todo valor monetário é armazenado em CENTAVOS (Int), nunca em float.
//   Dinheiro em ponto flutuante acumula erro de arredondamento e num sistema
//   de vendas isso vira divergência de caixa no fim do dia.
// - Campos de "tipo"/"status" são String porque o SQLite não suporta enum no
//   Prisma. Os valores aceitos estão documentados em cada campo e validados
//   na camada de aplicação, o que mantém o schema portável para PostgreSQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Quem opera o sistema. `papel` = "DONO" (acesso total) | "BALCONISTA" (só PDV).
model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     String   @default("BALCONISTA")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  caixasAbertos     Caixa[]
  vendas            Venda[]
  vendasCanceladas  Venda[]            @relation("VendasCanceladas")
  comandasAbertas   Comanda[]
  itensLancados     ItemComanda[]
  movimentosEstoque MovimentoEstoque[]
  movimentosCaixa   MovimentoCaixa[]

  @@index([email])
}

/// Agrupamento de produtos: Cerveja, Destilado, Refrigerante, Gelo, Tabacaria...
model Categoria {
  id       String   @id @default(cuid())
  nome     String   @unique
  cor      String   @default("#f59e0b")
  criadoEm DateTime @default(now())

  produtos Produto[]
}

model Produto {
  id           String  @id @default(cuid())
  nome         String
  codigoBarras String? @unique
  categoriaId  String

  /// Quanto o Capivaras paga no fornecedor, em centavos.
  precoCustoCentavos Int @default(0)
  /// Quanto o cliente paga, em centavos.
  precoVendaCentavos Int

  estoqueAtual  Int    @default(0)
  estoqueMinimo Int    @default(0)
  unidade       String @default("UN")

  /// Em quantas unidades o fornecedor vende. Cerveja em caixa de 12, gelo em
  /// fardo de 10. A sugestão de compra arredonda para cima até o múltiplo:
  /// pedir 47 latas quando a caixa tem 12 não é um pedido que exista.
  multiploCompra Int @default(1)

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  categoria    Categoria          @relation(fields: [categoriaId], references: [id])
  itensVenda   ItemVenda[]
  itensComanda ItemComanda[]
  movimentos   MovimentoEstoque[]

  @@index([categoriaId])
  @@index([nome])
}

/// Trilha de auditoria do estoque. Toda alteração de `Produto.estoqueAtual`
/// nasce de um registro aqui, para que a contagem seja sempre reconstituível.
/// `tipo` = "ENTRADA" | "SAIDA_VENDA" | "SAIDA_COMANDA" | "AJUSTE" | "PERDA"
model MovimentoEstoque {
  id        String @id @default(cuid())
  produtoId String
  tipo      String

  /// Positiva em entradas, negativa em saídas/perdas.
  quantidade            Int
  custoUnitarioCentavos Int?
  observacao            String?
  vendaId               String?
  usuarioId             String
  criadoEm              DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  venda   Venda?  @relation(fields: [vendaId], references: [id])

  @@index([produtoId])
  @@index([criadoEm])
}

/// Sessão de trabalho do balcão. `status` = "ABERTO" | "FECHADO".
model Caixa {
  id                      String    @id @default(cuid())
  usuarioAberturaId       String
  valorAberturaCentavos   Int       @default(0)
  abertoEm                DateTime  @default(now())
  fechadoEm               DateTime?
  /// Valor que o operador contou na gaveta ao fechar. A diferença para o
  /// esperado é a quebra de caixa do turno.
  valorFechamentoCentavos Int?
  status                  String    @default("ABERTO")
  observacao              String?

  usuarioAbertura Usuario          @relation(fields: [usuarioAberturaId], references: [id])
  vendas          Venda[]
  movimentos      MovimentoCaixa[]
  comandas        Comanda[]

  @@index([abertoEm])
  @@index([status])
}

/// Entrada ou retirada de dinheiro da gaveta fora de uma venda.
/// `tipo` = "SANGRIA" (retirada) | "SUPRIMENTO" (reforço).
model MovimentoCaixa {
  id            String   @id @default(cuid())
  caixaId       String
  tipo          String
  valorCentavos Int
  motivo        String
  usuarioId     String
  criadoEm      DateTime @default(now())

  caixa   Caixa   @relation(fields: [caixaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([caixaId])
}

/// `formaPagamento` = "DINHEIRO" | "PIX" | "DEBITO" | "CREDITO"
/// `status` = "CONCLUIDA" | "CANCELADA"
model Venda {
  id        String @id @default(cuid())
  /// Número sequencial legível para o cupom. O SQLite não permite
  /// autoincrement fora da chave primária, então é atribuído dentro da
  /// transação da venda (último número + 1).
  numero    Int    @unique
  caixaId   String
  usuarioId String

  subtotalCentavos Int
  descontoCentavos Int @default(0)
  totalCentavos    Int

  formaPagamento String
  status         String    @default("CONCLUIDA")
  criadoEm       DateTime  @default(now())
  canceladaEm    DateTime?

  /// Quem cancelou e por quê. Cancelamento mexe em dinheiro e em estoque:
  /// sem nome e motivo gravados, o buraco no caixa não tem a quem perguntar.
  canceladaPorId     String?
  motivoCancelamento String?

  caixa             Caixa              @relation(fields: [caixaId], references: [id])
  usuario           Usuario            @relation(fields: [usuarioId], references: [id])
  canceladaPor      Usuario?           @relation("VendasCanceladas", fields: [canceladaPorId], references: [id])
  itens             ItemVenda[]
  movimentosEstoque MovimentoEstoque[]
  comanda           Comanda?

  @@index([criadoEm])
  @@index([caixaId])
  @@index([status])
}

/// Linha de uma venda. Preço e custo são copiados do produto no momento da
/// venda: se o fornecedor reajustar amanhã, o relatório de margem de ontem
/// continua correto.
model ItemVenda {
  id                    String @id @default(cuid())
  vendaId               String
  produtoId             String
  quantidade            Int
  precoUnitarioCentavos Int
  custoUnitarioCentavos Int    @default(0)
  subtotalCentavos      Int

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([vendaId])
  @@index([produtoId])
}

/// Conta aberta de quem consome no local.
///
/// O Capivaras Beer tem mesas: o cliente senta, pede várias vezes ao longo da
/// noite e paga no fim. O PDV só sabe fazer venda fechada — bipa, paga, acaba
/// — então esse movimento acontecia no papel, fora do sistema.
///
/// `status` = "ABERTA" | "FECHADA" | "CANCELADA"
model Comanda {
  id            String @id @default(cuid())
  /// Número curto para gritar no balcão. Atribuído dentro da transação.
  numero        Int    @unique
  /// "Mesa 3", "João da esquina" — o que o balconista usa para achar a conta.
  identificacao String

  caixaId     String
  abertaPorId String
  abertaEm    DateTime  @default(now())
  fechadaEm   DateTime?
  status      String    @default("ABERTA")
  observacao  String?

  /// A venda gerada no fechamento. Só existe depois que a conta é paga.
  vendaId String? @unique

  caixa     Caixa         @relation(fields: [caixaId], references: [id])
  abertaPor Usuario       @relation(fields: [abertaPorId], references: [id])
  venda     Venda?        @relation(fields: [vendaId], references: [id])
  itens     ItemComanda[]

  @@index([status])
  @@index([caixaId])
}

/// Uma rodada lançada na conta.
///
/// Preço e custo são copiados no momento do lançamento, pela mesma razão do
/// ItemVenda: reajuste do fornecedor amanhã não reescreve a conta de hoje.
model ItemComanda {
  id                    String @id @default(cuid())
  comandaId             String
  produtoId             String
  quantidade            Int
  precoUnitarioCentavos Int
  custoUnitarioCentavos Int
  subtotalCentavos      Int

  lancadoPorId String
  criadoEm     DateTime @default(now())

  comanda    Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produtoId], references: [id])
  lancadoPor Usuario @relation(fields: [lancadoPorId], references: [id])

  @@index([comandaId])
}
